{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["bun", "node"]
  },
  "include": ["src", "test", "scripts"]
}


