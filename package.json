{
  "name": "litellm-discovery-core",
  "version": "0.1.0",
  "description": "Host-independent LiteLLM model discovery and metadata core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpchen/litellm-discovery-core.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:dist": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:package": "node scripts/test-package.mjs",
    "validate:spec": "openspec validate --all --strict --no-interactive",
    "test:openspec-closure": "node --test scripts/check-openspec-closure.test.mjs && node scripts/check-openspec-closure.mjs",
    "test:codebase-memory": "node --test scripts/codebase-memory.test.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@types/bun": "1.3.14",
    "@types/node": "24.4.0",
    "typescript": "5.8.2"
  }
}
